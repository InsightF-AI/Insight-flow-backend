{
  "title": "Insight Flow - Visão geral",
  "uid": "insightflow-visao-geral",
  "tags": ["insightflow"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "metricas",
        "label": "Métricas",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {}
      },
      {
        "name": "ambiente",
        "label": "Ambiente",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${metricas}" },
        "query": { "query": "label_values(up, ambiente)", "refId": "ambiente" },
        "definition": "label_values(up, ambiente)",
        "refresh": 1,
        "current": { "text": "producao", "value": "producao" }
      }
    ]
  },
  "panels": [
    { "type": "row", "title": "API", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "type": "stat",
      "title": "API no ar",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "targets": [{ "refId": "A", "expr": "max(up{job=\"insightflow-api\", ambiente=\"$ambiente\"})" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [{ "type": "value", "options": { "0": { "text": "FORA", "color": "red" }, "1": { "text": "NO AR", "color": "green" } } }],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Requisições por segundo",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 4, "w": 5, "x": 4, "y": 1 },
      "targets": [{ "refId": "A", "expr": "sum(rate(insightflow_http_requisicoes_total{ambiente=\"$ambiente\"}[5m]))" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Erros 5xx",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 4, "w": 5, "x": 9, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(insightflow_http_requisicoes_total{ambiente=\"$ambiente\", status=~\"5..\"}[5m])) / sum(rate(insightflow_http_requisicoes_total{ambiente=\"$ambiente\"}[5m])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 }] }
        }
      },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Latência p95",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 4, "w": 5, "x": 14, "y": 1 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(insightflow_http_duracao_segundos_bucket{ambiente=\"$ambiente\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 }] }
        }
      },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "stat",
      "title": "Falhas de job (24h)",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 4, "w": 5, "x": 19, "y": 1 },
      "targets": [
        { "refId": "A", "expr": "sum(increase(insightflow_job_execucoes_total{ambiente=\"$ambiente\", resultado=\"falha\"}[24h])) or vector(0)" }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] }
        }
      },
      "options": { "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "Requisições por status",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(insightflow_http_requisicoes_total{ambiente=\"$ambiente\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "timeseries",
      "title": "Latência p95 por rota (10 mais lentas)",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, metodo, rota) (rate(insightflow_http_duracao_segundos_bucket{ambiente=\"$ambiente\"}[5m]))))",
          "legendFormat": "{{metodo}} {{rota}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "table",
      "title": "Jobs do scheduler (24h)",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 13 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job, resultado) (increase(insightflow_job_execucoes_total{ambiente=\"$ambiente\"}[24h]))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value": "execuções" } } }
      ]
    },
    { "type": "row", "title": "Máquina e containers", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 } },
    {
      "type": "gauge",
      "title": "CPU da máquina",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 21 },
      "targets": [{ "refId": "A", "expr": "1 - avg(rate(node_cpu_seconds_total{ambiente=\"$ambiente\", mode=\"idle\"}[5m]))" }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "red", "value": 0.9 }] }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Memória da máquina",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 21 },
      "targets": [
        { "refId": "A", "expr": "1 - avg(node_memory_MemAvailable_bytes{ambiente=\"$ambiente\"} / node_memory_MemTotal_bytes{ambiente=\"$ambiente\"})" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.8 }, { "color": "red", "value": 0.9 }] }
        }
      }
    },
    {
      "type": "gauge",
      "title": "Disco (/)",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 21 },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - max(node_filesystem_avail_bytes{ambiente=\"$ambiente\", mountpoint=\"/\"} / node_filesystem_size_bytes{ambiente=\"$ambiente\", mountpoint=\"/\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.75 }, { "color": "red", "value": 0.85 }] }
        }
      }
    },
    {
      "type": "stat",
      "title": "Banco e cache",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 21 },
      "targets": [
        { "refId": "A", "expr": "max(pg_up{ambiente=\"$ambiente\"})", "legendFormat": "PostgreSQL" },
        { "refId": "B", "expr": "max(redis_up{ambiente=\"$ambiente\"})", "legendFormat": "Redis" },
        { "refId": "C", "expr": "sum(pg_stat_activity_count{ambiente=\"$ambiente\"})", "legendFormat": "Conexões no banco" }
      ],
      "options": { "colorMode": "value", "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "type": "timeseries",
      "title": "CPU por container",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{ambiente=\"$ambiente\"}[5m]))",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "type": "timeseries",
      "title": "Memória por container",
      "datasource": { "type": "prometheus", "uid": "${metricas}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (container_memory_working_set_bytes{ambiente=\"$ambiente\"})",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    { "type": "row", "title": "Logs e auditoria", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 } },
    {
      "type": "logs",
      "title": "Erros e avisos da API",
      "datasource": { "type": "loki", "uid": "${logs}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 36 },
      "targets": [
        { "refId": "A", "expr": "{ambiente=\"$ambiente\", container=\"insightflow-backend\", nivel=~\"ERROR|WARNING|CRITICAL\"}" }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "type": "logs",
      "title": "Eventos de segurança (login, logout, tokens, senha)",
      "datasource": { "type": "loki", "uid": "${logs}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 45 },
      "targets": [
        {
          "refId": "A",
          "expr": "{ambiente=\"$ambiente\", container=\"insightflow-backend\"} | json | evento=~\"login_aceito|login_recusado|logout|refresh_invalido|refresh_reutilizado|recuperacao_senha|senha_.*\""
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "type": "logs",
      "title": "Trilha de auditoria do banco",
      "datasource": { "type": "loki", "uid": "${logs}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 45 },
      "targets": [
        { "refId": "A", "expr": "{ambiente=\"$ambiente\", container=\"insightflow-postgres\"} |= \"auditoria tabela=\"" }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    },
    {
      "type": "logs",
      "title": "PostgreSQL: conexões, DDL, queries lentas e falhas de autenticação",
      "datasource": { "type": "loki", "uid": "${logs}" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 54 },
      "targets": [
        { "refId": "A", "expr": "{ambiente=\"$ambiente\", container=\"insightflow-postgres\"} != \"auditoria tabela=\"" }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true }
    }
  ]
}
