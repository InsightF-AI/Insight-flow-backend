# Banco de dados
DATABASE_URL=postgresql://insightflow:insightflow@localhost:5432/insightflow
TEST_DATABASE_URL=postgresql://insightflow:insightflow@localhost:5432/insightflow_test

# Cache
REDIS_URL=redis://localhost:6381/0
CACHE_TTL_COTACAO_ATUAL_SEGUNDOS=60
CACHE_TTL_HISTORICO_SEGUNDOS=86400
CACHE_TTL_CATALOGO_CRIPTO_SEGUNDOS=86400
WS_TIMEOUT_AUTENTICACAO_SEGUNDOS=10
WS_INTERVALO_PING_SEGUNDOS=30
HISTORICO_BACKFILL_PERIODO=3M
HISTORICO_BACKFILL_PERIODO_CRIPTO=5A
HISTORICO_MINIMO_COTACOES=50
INDICES_REFERENCIA_HORA=19
INDICES_REFERENCIA_MINUTO=0

# Autenticação
JWT_SECRET_KEY=
JWT_EXPIRATION_MINUTES=30
REFRESH_TOKEN_EXPIRACAO_DIAS=30
CORS_ORIGENS=["http://localhost:5173"]

# Logs
LOG_NIVEL=INFO
LOG_FORMATO=json

# APIs externas de dados de mercado
BRAPI_API_KEY=
BINANCE_BASE_URL=https://api.binance.com
BINANCE_API_KEY=
BINANCE_API_SECRET=
BRAPI_REQUISICOES_POR_MINUTO=60
BINANCE_REQUISICOES_POR_MINUTO=600
INTEGRACOES_TENTATIVAS=3
INTEGRACOES_BACKOFF_BASE_SEGUNDOS=0.5
INTEGRACOES_ESPERA_MAXIMA_SEGUNDOS=10

# Push mobile (Expo)
EXPO_PUSH_HABILITADO=true
EXPO_BASE_URL=https://exp.host
EXPO_ACCESS_TOKEN=
EXPO_REQUISICOES_POR_MINUTO=300
EXPO_RECIBOS_INTERVALO_MINUTOS=30

# Web Push (VAPID) — gere a chave com: python -m app.scripts.gerar_chaves_vapid
WEB_PUSH_HABILITADO=true
WEB_PUSH_VAPID_CHAVE_PRIVADA=
WEB_PUSH_VAPID_CONTATO=
WEB_PUSH_HOSTS_PERMITIDOS=["fcm.googleapis.com","updates.push.services.mozilla.com","*.push.apple.com","*.notify.windows.com"]
WEB_PUSH_REQUISICOES_POR_MINUTO=300
WEB_PUSH_TTL_SEGUNDOS=86400

# Provedor de IA
AI_HABILITADA=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
